# Copy to apps/api/.env (gitignored) and restart `pnpm dev`.
# With a key set, Find Best Matches and Analyze Resume use Claude (claude-opus-5-5);
# without one they use the built-in local engine.
ANTHROPIC_API_KEY=
# Set to "local" to force the built-in engine even when a key is present.
# VEYRO_AI_PROVIDER=local

# Real email (https://resend.com). Without these, emails are only recorded in the Dev Outbox.
# EMAIL_FROM must use a domain verified in Resend, e.g. "VeyroApp <no-reply@yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM=
# EMAIL_REPLY_TO=support@yourdomain.com
# EMAIL_DELIVERY=off   # force simulated email even when a key is set
