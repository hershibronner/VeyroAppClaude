{
  "name": "@veyro/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx seed/index.ts",
    "reset": "tsx src/reset.ts && tsx src/migrate.ts && tsx seed/index.ts",
    "typecheck": "tsc -p .",
    "seed-if-empty": "tsx src/seed-if-empty.ts"
  },
  "dependencies": {
    "@veyro/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "pg": "^8.13.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.11.11"
  }
}
